{
  "expo": {
    "name": "AFTERLIGHT",
    "slug": "afterlight",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08130F",
    "scheme": "afterlight",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08130F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.rixel.afterlight",
      "buildNumber": "1",
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.rixel.afterlight",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E1A17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#08130F",
          "dark": {
            "backgroundColor": "#08130F"
          }
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-localization",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "\n# AFTERLIGHT: Expo view managers instantiate views by reflection\n-keep class expo.modules.gl.** { *; }\n-keep class expo.modules.kotlin.views.** { *; }\n-keepclassmembers class * extends android.view.View {\n    <init>(...);\n}\n"
          }
        }
      ]
    ],
    "extra": {
      "privacy": "no telemetry, no ads, no network"
    }
  }
}